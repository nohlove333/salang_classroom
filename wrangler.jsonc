{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "salang-classroom",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES"
    }
  ],
  "observability": {
    "enabled": true
  }
}
