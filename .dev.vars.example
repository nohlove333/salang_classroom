TEACHER_SETUP_KEY="replace-with-a-long-private-key"
DRIVE_ARCHIVE_URL="https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID/exec"
DRIVE_ARCHIVE_KEY="replace-with-the-same-archive-key-used-in-apps-script"
# Google Calendar OAuth: register these as Worker variables/secrets, never commit real values.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://salang-classroom.nohlove333.workers.dev/api/calendar/callback"
# Base64url encoding of 32 cryptographically random bytes. Keep stable; rotating requires reconnect.
CALENDAR_TOKEN_KEY=""

# Optional owner-only aggregate telemetry. Use the existing teacher ID; never an email guessed by the client.
OWNER_TEACHER_ID=""

# Optional Cloudflare account analytics (owner opens the panel; no background polling).
CF_ANALYTICS_ACCOUNT_ID=""
# Analytics Read API token for that account. Store as Worker secret, never in the browser.
CF_ANALYTICS_TOKEN=""

# Optional resource filters for site-only analytics. Leave unknown IDs empty.
CF_METRICS_WORKER="salang-classroom"
CF_METRICS_D1_ID=""
CF_METRICS_R2_BUCKET=""
CF_METRICS_DO_ID=""
